{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/invite/**", "destination": "/invite.html" }
    ],
    "appAssociation": "AUTO"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "crapapps-65472",
          "appId": "1:7789770188:android:bbce140cd9a8cc1011d969",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "crapapps-65472",
          "configurations": {
            "android": "1:7789770188:android:bbce140cd9a8cc1011d969",
            "ios": "1:7789770188:ios:77b629d9d170379111d969"
          }
        }
      },
      "ios": {
        "default": {
          "projectId": "festivalrumour",
          "appId": "1:932830993877:ios:305435e5f88179e504315c",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    },
    {
      "source": "functions_comment",
      "codebase": "comment_push",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
